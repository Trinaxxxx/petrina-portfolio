# dependencies
node_modules/

# stray repo-root lockfile (there is no root package.json; the app lives in
# portfolio/). A lockfile here makes Vercel infer the wrong workspace root and
# breaks next/font/google. Root-anchored so portfolio/package-lock.json stays.
/package-lock.json

# builds / derived artifacts
dist/
build/
*.tsbuildinfo

# large video media — hosted on Vercel Blob, not committed (see scripts/upload-videos.mjs)
*.mp4

# env & secrets
.env
.env.*

# logs
*.log

# OS / editor cruft
.DS_Store

# deploy / tooling
.vercel

# local AI tooling & personal config (not part of the project)
.claude/settings.local.json
.claude/skills/
.impeccable/
_local-notes/
portfolio/Skills/
